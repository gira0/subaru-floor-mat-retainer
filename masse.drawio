ze:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;A&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Dicke Band&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Dicke des flachen Plastikbandes, an einer glatten Stelle&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;B&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Breite Band&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Breite des Bandes, quer gemessen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Gesamtlänge&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Teil flach hinlegen: Ende am Pin bis ganz außen am Haken&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;D&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;gerades Stück&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Pin-Ende bis dort, wo die schräge Stufe anfängt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;E&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Höhe Stufe&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Wie viel höher der hintere Teil liegt (Unterseite zu Unterseite)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;F&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Länge Stufe&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Waagerecht von Biegung zu Biegung&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;G&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Winkel Stufe&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Wie steil die Stufe ansteigt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;H&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Hakentiefe&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Oberseite Band bis Hakenspitze&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;I&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Hakenwinkel&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;90° = rechtwinklig; zeigt die Spitze etwas nach innen, ist es mehr&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;J&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Pin-Abstand&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Mitte Pin bis Bandende (Ende ist rund, Pin = Mittelpunkt)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;K&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Pin Stiel&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Dicke des Stiels&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;L&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Pin Kopf&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Dicke des Kopfes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;M&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Pin Hals&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Oberseite Band bis Unterkante Kopf&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;N&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Kopfhöhe&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Nur der Kopf (oben und unten voll abgerundet)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;O&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Clip-Abstand&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Mitte Clip bis Außenseite Haken&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;P&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Clip-Länge&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Wie weit der Clip unten heraussteht&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;Q&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Lamellen-Größe&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Lamelle (abgerundetes Quadrat), Kante zu Kante&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;R&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Plus-Steg breit&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Breite eines Stegs vom Plus&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;S&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Plus-Größe&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Länge eines Stegs vom Plus, außen gemessen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;T&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Lamellen&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Anzahl der Lamellen am Clip&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;U&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Rippe Breite&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Wie dick der Versteifungssteg in der Mitte ist&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;V&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Rippe Schräge&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Wie weit die Rippe an der Schräge übersteht&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;W&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Rippe oben&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Wie weit sie am oberen Teil (Clip-Seite) übersteht&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;Z&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Rippe am Pin&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Gesamthöhe der Rippe auf dem geraden Stück am Pin (sitzt mittig im Band)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;a&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Streben-Abstand&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Pin-Mitte bis Mitte der 2. Querstrebe&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;b&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Strebe dick&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Dicke einer Querstrebe, in Längsrichtung gemessen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;c&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Strebe hoch&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Wie weit eine Querstrebe auf der Rückseite übersteht&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;d&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Strebe lang&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Länge einer Querstrebe, quer zum Band (= volle Breite)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;e&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Lamellen-Abstand&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Abstand der Lamellen zueinander (Mitte zu Mitte)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;f&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Clip-Block&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Massiver Block direkt am Band, Dicke&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;g&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Lamelle dick&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Dicke einer Lamelle&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#c62828&quot;&gt;&lt;b&gt;h&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Lamelle Ecke&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Eckenradius der Lamellen (wie rund sind die Ecken?)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;i&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Clip-Spitze&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Länge der stumpfen Spitze am Clip-Ende&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#c62828&quot;&gt;&lt;b&gt;j&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Spitze vorne&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Wie breit das Plus ganz vorne an der Spitze noch ist&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;k&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Kuppel Ø&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Runde Erhebung auf der Pin-Seite, gegenüber vom Clip: Durchmesser&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;l&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Kuppel hoch&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Höhe der Kuppel in der Mitte (so hoch wie die Rippe W)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;m&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Haken-Anschlag&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Block an der Hakenspitze: Länge (volle Breite, außen bündig mit der Rippe)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="54" width="500" height="814" as="geometry"/></mxCell><mxCell id="c150" value="Den Biegeradius der Stufe muss man nicht messen, er ergibt sich aus E, F und G." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1080" y="894" width="500" height="18" as="geometry"/></mxCell><mxCell id="c151" value="Die Werte danach in bracket.scad beim gleichen Buchstaben eintragen." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1080" y="914" width="500" height="18" as="geometry"/></mxCell><mxCell id="c152" value="Rippe im Querschnitt (vergrößert)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="954" width="520" height="24" as="geometry"/></mxCell><mxCell id="c153" value="an der Schräge