tArrow=none;startFill=1;endFill=1;startSize=5;endSize=5;strokeWidth=0.8;strokeColor=#1f5fbf;rounded=0;arcSize=40;dashed=1;dashPattern=4 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="792" y="808.8" as="sourcePoint"/><mxPoint x="824" y="808.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c143" style="html=1;endArrow=block;startArrow=block;startFill=1;endFill=1;startSize=5;endSize=5;strokeWidth=1.0;strokeColor=#1f5fbf;rounded=0;arcSize=40;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="818" y="791.2" as="sourcePoint"/><mxPoint x="818" y="808.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c144" value="&lt;b&gt;R&lt;/b&gt; = 2.2 mm" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1a7f37;" vertex="1" parent="1"><mxGeometry x="824" y="791.0" width="80" height="18" as="geometry"/></mxCell><mxCell id="c145" value="&lt;b&gt;h&lt;/b&gt; = ____ mm" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=12;fontColor=#c62828;" vertex="1" parent="1"><mxGeometry x="640" y="818" width="90" height="18" as="geometry"/></mxCell><mxCell id="c146" value="(lamella corner)" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="610" y="836" width="170" height="16" as="geometry"/></mxCell><mxCell id="c147" value="light = lamella, dark = plus" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="660" y="860" width="200" height="16" as="geometry"/></mxCell><mxCell id="c148" value="What is what?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="20" width="500" height="26" as="geometry"/></mxCell><mxCell id="c149" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;A&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Strip thickness&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Thickness of the flat plastic strip, at a smooth spot&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;B&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Strip width&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Width of the strip, measured across&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Overall length&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Part lying flat: pin end to the very outside of the hook&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;D&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Straight section&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Pin end up to where the step starts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;E&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Step height&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;How much higher the upper section sits (underside to underside)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;F&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Step length&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Measured horizontally, bend to bend&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;G&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Step angle&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;How steep the step rises&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;H&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Hook depth&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Top of strip to hook tip&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;I&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Hook angle&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;90° = square; more if the tip points slightly inwards&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;J&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Pin position&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Pin centre to strip end (end is round, pin = centre)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;K&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Pin shaft&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Shaft diameter&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;L&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Pin head&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Head diameter&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;M&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Pin neck&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Top of strip to underside of head&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;N&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Head height&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Head only (fully rounded top and bottom)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;O&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Clip position&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Clip centre to outside of hook&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;P&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Clip length&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;How far the clip sticks out below&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;Q&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Lamella size&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Lamella (rounded square), edge to edge&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;R&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Plus web width&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Width of one web of the plus&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;S&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Plus size&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Length of one web of the plus, outside&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;T&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Lamellae&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Number of lamellae on the clip&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;U&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Rib width&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Width of the stiffening rib&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;V&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Rib on slope&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;How far the rib sticks out on the slope&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;W&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Rib upper&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;How far it sticks out on the upper (clip) section&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;Z&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Rib at pin&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Total rib height on the straight pin section (centred in the strip)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;a&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Strut spacing&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Pin centre to centre of the 2nd cross strut&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;b&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Strut thickness&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Thickness of a cross strut, measured lengthwise&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;c&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Strut height&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;How far a cross strut sticks out on the back&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;d&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Strut length&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Length of a cross strut, across the strip (= full width)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;e&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Lamella spacing&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Spacing of the lamellae (centre to centre)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;f&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Clip block&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Solid block right at the strip, thickness&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;g&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Lamella thickness&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Thickness of one lamella&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#c62828&quot;&gt;&lt;b&gt;h&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Lamella corner&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Corner radius of the lamellae&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;i&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Clip tip&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Length of the blunt tip at the clip end&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#c62828&quot;&gt;&lt;b&gt;j&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Tip width&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Width of the plus at the very tip&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;k&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Dome Ø&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Round dome on the pin side, opposite the clip: diameter&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;l&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Dome height&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Dome height at the centre (same as rib W)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;color:#1a7f37&quot;&gt;&lt;b&gt;m&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;Hook stop&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Block at the hook tip: length (full width, flush with the rib)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="54" width="500" height="814" as="geometry"/></mxCell><mxCell id="c150" value="The bend radius of the step follows from E, F and G and does not need measuring." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1080" y="894" width="500" height="18" as="geometry"/></mxCell><mxCell id="c151" value="The same letters are used for the parameters in bracket.scad." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1080" y="914" width="500" height="18" as="geometry"/></mxCell><mxCell id="c152" value="Rib cross-section (enlarged)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="954" width="520" height="24" as="geometry"/></mxCell><mxCell id="c153" value="on the slope" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="994" width="200" height="18" as="geo